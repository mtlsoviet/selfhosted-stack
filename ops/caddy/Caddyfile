{
	email {$ACME_EMAIL}
}

grafana.{$DOMAIN} {
	reverse_proxy grafana:3000        # Grafana's internal port
}

status.{$DOMAIN} {
	reverse_proxy uptime-kuma:3001    # Uptime Kuma's internal port
}

s3.{$DOMAIN} {
	@backup_clients remote_ip {$APPS_IP} {$GAME_IP}

	handle @backup_clients {
		reverse_proxy garage:3900
	}
	handle {
		respond 403
	}
}

