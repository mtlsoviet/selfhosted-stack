# File: caddy/Caddyfile   repo: selfhosted-stack   ends up on: apps:/opt/selfhosted-stack/caddy/Caddyfile

# Global options: this first block, with no site name, applies to everything
{
	email {$ACME_EMAIL}
}

# One block per site. The name is the hostname; Caddy gets and renews its certificate by itself.
vault.{$DOMAIN} {
	reverse_proxy vaultwarden:80
}

wiki.{$DOMAIN} {
	reverse_proxy bookstack:80
}

home.{$DOMAIN} {
	reverse_proxy portal:8080
}

auth.{$DOMAIN} {
	reverse_proxy authentik-server:9000
}
